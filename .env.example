# ==========================================================
# CREOVA AI Creator Intelligence Marketplace
# Root Environment Configuration (.env.example)
# ==========================================================

PROJECT_NAME="CREOVA — AI Creator Intelligence Marketplace"
API_V1_STR="/api/v1"
SECRET_KEY="creova-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for rapid hackathon testing, PostgreSQL supported)
DATABASE_URL="sqlite:///./creova.db"

# ----------------------------------------------------------
# Environment & Safe Development Testing Mode
# ----------------------------------------------------------
ENVIRONMENT="development" # "development" or "production"
DEV_OTP_MODE="true"        # In dev mode, OTP codes are logged to backend console if external keys are unset

# ----------------------------------------------------------
# Real Email OTP Delivery Provider (SMTP)
# Compatible with SendGrid, Amazon SES, Brevo, Mailgun, Gmail App Password
# ----------------------------------------------------------
SMTP_HOST=""               # e.g. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com, smtp.gmail.com
SMTP_PORT=587              # TLS port: 587, SSL port: 465
SMTP_USER=""               # SMTP username or 'apikey' (SendGrid)
SMTP_PASSWORD=""           # SMTP password or application password
SMTP_FROM_EMAIL="noreply@creova.ai"
SMTP_TLS="true"
SMTP_SSL="false"

# ----------------------------------------------------------
# Real SMS OTP Delivery Provider (Twilio)
# Compatible with Twilio Programmable SMS
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=""      # Starts with AC...
TWILIO_AUTH_TOKEN=""       # Twilio Auth Token
TWILIO_FROM_NUMBER=""      # E.164 phone number, e.g. +15017122661

# ----------------------------------------------------------
# OTP Security & Rate Limiting Enforcement
# ----------------------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ----------------------------------------------------------
# Model 1 & 2: Google Gemini & Embeddings Configuration
# Keep server-side only in backend/.env; never expose in frontend builds.
# ----------------------------------------------------------
LLM_PROVIDER="gemini"
GEMINI_API_KEY="" # Paste your Google Gemini API Key here (starts with AIzaSy...)
GEMINI_MODEL="gemini-3.5-flash-lite" # Supported models: gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_EMBEDDING_MODEL="gemini-embedding-001" # Supported embedding model

# ----------------------------------------------------------
# Creator-Campaign Hybrid Matching Weights (Sum = 1.0)
# ----------------------------------------------------------
WEIGHT_NICHE_SKILL=0.30
WEIGHT_AUDIENCE=0.25
WEIGHT_BUDGET=0.20
WEIGHT_PLATFORM_LANG=0.15
WEIGHT_ENGAGEMENT=0.10

# ----------------------------------------------------------
# Model 3: Trainable Ranking Model Artifacts Path
# ----------------------------------------------------------
ML_MODELS_DIR="ml/models"
ACTIVE_RANKER_MODEL="ranker_gradient_boosting_v1.joblib"

# ----------------------------------------------------------
# CORS Allowed Origins
# ----------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5173"]
